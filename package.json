{
  "name": "front-end-hospital",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FRONT-END HOSPITAL — a real-time multiplayer diagnosis game for front-end students. Host opens an Emergency Room, up to 12 doctors join and each diagnoses one sick website.",
  "keywords": [
    "multiplayer",
    "socket.io",
    "classroom",
    "game",
    "front-end",
    "teaching"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "socket.io-client": "^4.8.3"
  }
}
