# ─────────────────────────────────────────────────────────────
#  FRONT-END HOSPITAL — environment configuration
#  Copy this file to `.env` and edit if you need to.
#  Everything here has a sane default, so `.env` is OPTIONAL.
# ─────────────────────────────────────────────────────────────

# Port the game server listens on.
PORT=3000

# Public origin used when the Host screen builds the shareable join link.
# Leave EMPTY for local play — the browser figures the URL out by itself.
# Set it when you deploy, e.g. PUBLIC_ORIGIN=https://front-end-hospital.onrender.com
PUBLIC_ORIGIN=

# Max doctors per room (game is designed around 12, hard ceiling is 12).
MAX_PLAYERS=12

# Minimum doctors required before the Host can press START EMERGENCY.
MIN_PLAYERS=2

# How long an empty room survives before it is garbage-collected (minutes).
# Generous by default so a class can take a coffee break mid-game.
ROOM_TTL_MINUTES=240

# Where the crash-recovery snapshot is written. Relative to the project root.
DATA_DIR=.data

# Set to "false" to disable writing snapshots to disk (pure in-memory mode).
PERSIST=true
